# Copy this file to .env (development) and fill in real values. Never commit .env itself -
# it's already covered by .gitignore. Production secrets belong in the hosting platform's
# environment/secret manager, never in a committed file (section 25).

# --- Database (Phase 14) ---------------------------------------------------
# Local dev Postgres (see prisma/schema.prisma). Format:
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/b2b_procurement?schema=public"

# --- Auth --------------------------------------------------------------
# Random 32+ byte secret used to sign/verify session-related tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_ME"

# Session cookie lifetime, in seconds. 7 days by default.
SESSION_TTL_SECONDS=604800

# --- Environment ---------------------------------------------------------
# development | test | staging | production
NODE_ENV="development"

# --- Mobile money gateways (section 26's provider abstraction) --------------
# Real values are never committed. Each of the three networks needs all three of
# _SUBSCRIPTION_KEY/_API_USER/_API_KEY before its provider (server/services/payment/gateways/
# mobileMoneyProvider.ts) will attempt a real HTTP charge - missing any one of them, that
# network falls back to an instant-success simulation instead (so the app stays usable without a
# merchant agreement). A charge against a real gateway is asynchronous - it comes back PENDING,
# not PAID, until the customer approves the prompt on their phone and either a webhook
# (POST /api/webhooks/payments/[provider]) or the reconciliation job below confirms it.
#
# MTN MoMo's Collections API is publicly documented at momodeveloper.mtn.com - sign up there for
# a free sandbox subscriptionKey/apiUser/apiKey; the base URL default below already points at
# MTN's own sandbox. Telecel Cash and AirtelTigo Money have no equivalent public developer
# portal - get real values (and confirm the actual base URL/endpoint paths, which this repo has
# NOT verified for these two networks the way it has for MTN) from that network's own
# integration team or a licensed aggregator (Hubtel, ExpressPay, Paystack, ...).
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"

TELECEL_CASH_BASE_URL=""
TELECEL_CASH_SUBSCRIPTION_KEY=""
TELECEL_CASH_API_USER=""
TELECEL_CASH_API_KEY=""
TELECEL_CASH_TARGET_ENVIRONMENT="sandbox"

AIRTELTIGO_MONEY_BASE_URL=""
AIRTELTIGO_MONEY_SUBSCRIPTION_KEY=""
AIRTELTIGO_MONEY_API_USER=""
AIRTELTIGO_MONEY_API_KEY=""
AIRTELTIGO_MONEY_TARGET_ENVIRONMENT="sandbox"

# HMAC-SHA256 secret for verifying inbound payment webhooks (Phase 14, Stage 11 - section 20's
# "verify webhook signatures" rule). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Every request to POST /api/webhooks/payments/[provider] is rejected while this is empty - it's
# optional only in the sense that nothing currently sends real webhooks yet.
PAYMENT_WEBHOOK_SIGNING_SECRET=""

# --- Background jobs (deployment-readiness follow-up to section 16) ---------
# Shared secret an external scheduler sends as the `x-cron-secret` header on every
# POST /api/cron/* request. Generate the same way as the webhook secret above. Every cron route
# is rejected while this is empty. Point your scheduler (Vercel Cron, a GitHub Actions cron job,
# system crontab + curl, ...) at:
#   POST /api/cron/invoice-due-sweep       - hourly or so; flips PENDING invoices past their due
#                                            date to OVERDUE and notifies the billed company.
#   POST /api/cron/low-stock-sweep         - hourly or so; notifies each supplier's admins once
#                                            per product per 24h while stock is at or below
#                                            threshold.
#   POST /api/cron/pending-payment-sweep   - every few minutes; reconciles mobile money payments
#                                            still PENDING because a webhook never arrived. Only
#                                            does anything once a real gateway above is
#                                            configured.
CRON_SECRET=""

# --- Object storage (section 18 - future stage) -----------------------------
# S3-compatible bucket for invoices/documents/attachments.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""

# --- Redis / background jobs (section 16 - future stage) --------------------
REDIS_URL=""
