# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored - never commit real secrets.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=myusers
MYSQL_USER=xwiggy
MYSQL_PASSWORD=change-me

# Consumed by xwiggy-back's application-prod.properties
DB_URL=jdbc:mysql://mysql:3306/myusers?useSSL=false
DB_USERNAME=xwiggy
DB_PASSWORD=change-me

# Generate a real one, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

CORS_ALLOWED_ORIGINS=http://localhost:4200
